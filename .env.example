# ==============================================================================
# CeloAgent - Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit real private keys or API keys to repository control.
# ==============================================================================

# Celo Network Configuration
# Supported values: "sepolia" | "mainnet"
CELO_NETWORK=sepolia

# Celo RPC Endpoints (Default public endpoints; override if using dedicated provider like Ankr/QuickNode)
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CELO_MAINNET_RPC_URL=https://forno.celo.org

# Spending Limit Policy (Default safe cap: 0.01 CELO per testnet payment)
CELO_MAX_PAYMENT=0.01

# Server-side signer boundary. Configure an HSM/KMS-backed AgentSignerProvider
# during application startup; private keys must never be placed in this file.
AGENT_SIGNER_PROVIDER=external-kms
AGENT_SIGNER_ENDPOINT=

# Trusted cUSD token contracts used for cUSD execution and settlement receipt verification.
# Official Celo Docs: https://docs.celo.org/build/tools/contracts/stablecoin-contracts
CELO_SEPOLIA_CUSD_ADDRESS=0xEF4d55D6dE8e8d73232827Cd1e9b2F2dBb45bC80
# Mainnet execution is not enabled in this phase; configure only when explicitly approved.
CELO_MAINNET_CUSD_ADDRESS=

# ERC-8004 Contract Addresses (To be configured in deployment phase)
NEXT_PUBLIC_ERC8004_IDENTITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_ERC8004_REPUTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_ERC8004_VALIDATION_REGISTRY_ADDRESS=

# PostgreSQL durable state
DATABASE_URL=
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# AI Model Provider API Key (Placeholder for future phases)
AI_MODEL_API_KEY=
